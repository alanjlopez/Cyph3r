# --- Neo4j connection ---
# Use the Connection URI shown in Neo4j Desktop (e.g. neo4j://127.0.0.1:7687).
# For a Docker dev instance, bolt://localhost:7687 also works. Both schemes are fine
# for a single local instance.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# --- LLM ---
CYPH3R_LLM_PROVIDER=anthropic
CYPH3R_MODEL=claude-opus-4-8
ANTHROPIC_API_KEY=sk-ant-...

# --- Agent behaviour ---
CYPH3R_CONFIRM_WRITES=false
CYPH3R_MAX_REPAIR_ATTEMPTS=3
CYPH3R_MAX_STEPS=16
CYPH3R_META_LABEL_PREFIX=Cyph3r
